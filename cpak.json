{
  "manifest_version": "1.0",
  "name": "GIMP",
  "description": "Create images and edit photographs.",
  "version": "3.0.0",
  "image": "ghcr.io/containerpak/gimp:main",
  "binaries": ["/usr/bin/gimp"],
  "desktop_entries": ["/usr/share/applications/org.gimp.GIMP.desktop"],
  "dependencies": [],
  "addons": [],
  "idle_time": 0,
  "override": {
    "socketX11": true,
    "socketWayland": true,
    "socketPulseAudio": true,
    "socketSessionBus": true,
    "socketSystemBus": false,
    "socketSshAgent": false,
    "socketCups": false,
    "socketGpgAgent": false,
    "socketAtSpiBus": true,
    "socketBluetooth": false,
    "deviceDri": true,
    "deviceKvm": false,
    "deviceShm": true,
    "deviceAlsa": false,
    "deviceVideo": false,
    "deviceFuse": false,
    "deviceTun": false,
    "deviceUsb": false,
    "deviceAll": false,
    "notification": false,
    "fsHost": false,
    "fsHostEtc": false,
    "fsHostHome": true,
    "fsExtra": [],
    "env": [],
    "network": true,
    "process": false,
    "asRoot": false,
    "allowedHostCommands": []
  }
}
